{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;Encrypt=True;TrustServerCertificate=False;"
  },
  "Jwt": {
    "Issuer": "QuanLySinhVien.Api",
    "Audience": "QuanLySinhVien.Clients",
    "Key": "SET_WITH_USER_SECRETS_TO_A_LONG_RANDOM_VALUE",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "FaceRecognition": {
    "DescriptorLength": 512,
    "MatchThreshold": 0.35,
    "AmbiguityMargin": 0.04,
    "SampleConsistencyThreshold": 0.70
  },
  "FaceEvidence": {
    "ModelDirectory": "Models/Face",
    "MinimumLiveScore": 0.80,
    "MinimumTurn": 0.12
  },
  "Cloudinary": {
    "Enabled": false,
    "CloudName": "SET_WITH_USER_SECRETS",
    "ApiKey": "SET_WITH_USER_SECRETS",
    "ApiSecret": "SET_WITH_USER_SECRETS",
    "Folder": "huit-attendance/face-review"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

@{ ViewData["Title"] = "Duyệt hồ sơ khuôn mặt"; }
<div id="face-profile-workspace" data-api-root="/quan-ly/ho-so-khuon-mat/api/">
    <header class="page-heading">
        <div><p class="eyebrow blue">@(User.IsInRole(RoleNames.Admin) ? "QUẢN TRỊ VIÊN" : "CÁN BỘ QUẢN LÝ")</p>
        <h1>Duyệt hồ sơ khuôn mặt</h1>
        <p>Xác minh danh tính và duyệt hồ sơ sinh viên một lần để sử dụng tại tất cả lớp học.</p></div>
        <a asp-controller="Home" asp-action="Index" class="button secondary">Về trang quản lý</a>
    </header>
    @Html.AntiForgeryToken()
    <p id="attendance-status" role="status" aria-live="polite">Đang tải hồ sơ sinh viên…</p>
    <div class="role-grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));margin-bottom:24px">
        <article><p>Tổng hồ sơ</p><strong id="profile-total" style="font-size:2rem">—</strong></article>
        <article><p>Chờ xác minh và duyệt</p><strong id="profile-pending" style="font-size:2rem;color:#975a16">—</strong></article>
        <article><p>Đã duyệt</p><strong id="profile-approved" style="font-size:2rem;color:#087443">—</strong></article>
        <article><p>Yêu cầu đăng ký lại</p><strong id="profile-rejected" style="font-size:2rem;color:#b42318">—</strong></article>
    </div>
    <section class="panel section-gap">
        <h2>Hồ sơ sinh viên</h2>
        <div class="form-actions" style="align-items:end">
            <div><label for="profile-search">Tìm sinh viên</label><input id="profile-search" type="search" placeholder="Mã sinh viên hoặc họ tên" /></div>
            <div><label for="profile-filter">Trạng thái</label><select id="profile-filter"><option value="pending">Chờ duyệt</option><option value="approved">Đã duyệt</option><option value="rejected">Yêu cầu đăng ký lại</option><option value="all">Tất cả hồ sơ</option></select></div>
            <button id="refresh-profiles" class="button secondary" type="button">Tải lại danh sách</button>
        </div>
        <p>Chọn <strong>Đối chiếu ảnh</strong> để xem ảnh thẻ từ hồ sơ gốc và ảnh sinh viên đã chụp khi đăng ký. Sinh viên không cần có mặt để duyệt hồ sơ.</p>
        <div id="profiles" class="table-card" aria-live="polite"></div>
    </section>
    <dialog id="profile-review-dialog" style="width:min(1100px,95vw);max-height:92vh;border:1px solid #d8e9f3;border-radius:16px;padding:24px">
        <div class="page-heading"><div><h2 id="review-student">Đối chiếu ảnh</h2><p id="review-metadata"></p></div><button id="close-review" class="button secondary" type="button">Đóng</button></div>
        <p id="review-status" role="status" aria-live="polite"></p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px">
            <section class="panel"><h3>Ảnh thẻ từ hồ sơ sinh viên</h3><img id="identity-photo" hidden alt="Ảnh thẻ trong hồ sơ gốc" style="width:100%;height:280px;object-fit:contain" /><p id="identity-photo-empty">Chưa có ảnh thẻ được xác nhận.</p><p id="identity-photo-source"></p>
                <div id="identity-photo-upload"><label for="identity-photo-file">Cập nhật từ hồ sơ gốc (JPEG/PNG, tối đa 1 MB)</label><input id="identity-photo-file" type="file" accept="image/jpeg,image/png" /><button id="save-identity-photo" class="button secondary" type="button">Cập nhật ảnh thẻ</button><p>Chỉ CBQL/Admin cập nhật ảnh thẻ; không sử dụng ảnh đại diện tự chọn của sinh viên.</p></div>
            </section>
            <section class="panel"><h3>Ảnh chụp lúc đăng ký</h3><p>Các ảnh đã qua kiểm tra người thật và động tác khi sinh viên đăng ký. Nhấn vào ảnh để xem lớn.</p><div id="registration-photos" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px"></div></section>
        </div>
        <div id="review-decision-controls" style="margin-top:20px">
            <label><input id="confirm-photo-comparison" type="checkbox" /> Tôi đã đối chiếu ảnh thẻ với ảnh đăng ký và xác nhận đúng sinh viên.</label>
            <label for="review-note">Ghi chú / lý do yêu cầu đăng ký lại</label><textarea id="review-note" maxlength="500" rows="3" style="width:100%" placeholder="Bắt buộc có lý do khi yêu cầu đăng ký lại, ví dụ: ảnh mờ hoặc không khớp ảnh thẻ."></textarea>
            <div class="form-actions"><button id="approve-profile" class="button primary-link" type="button" disabled>Duyệt hồ sơ</button><button id="reject-profile" class="button secondary" type="button">Yêu cầu đăng ký lại</button><button id="reload-review" class="button secondary" type="button">Tải lại hồ sơ</button></div>
        </div>
    </dialog>
    <dialog id="photo-zoom-dialog" style="max-width:94vw;max-height:94vh;border:0;border-radius:12px"><p id="photo-zoom-label"></p><img id="photo-zoom" alt="Ảnh đối chiếu phóng to" style="max-width:85vw;max-height:75vh;object-fit:contain" /><p><button id="close-photo-zoom" type="button" class="button secondary">Đóng ảnh</button></p></dialog>
</div>
<script defer src="~/js/face-profile-review.js" asp-append-version="true"></script>

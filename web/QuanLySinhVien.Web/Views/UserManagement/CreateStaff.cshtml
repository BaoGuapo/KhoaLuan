@model CreateStaffAccountViewModel
@{ ViewData["Title"] = "Tạo tài khoản nội bộ"; }
<section class="form-card"><div class="form-heading"><p class="eyebrow blue">ADMIN</p><h1>Tạo tài khoản nội bộ</h1><p>Dành cho quản trị viên hoặc cán bộ quản lý.</p></div><form method="post"><div asp-validation-summary="ModelOnly" class="validation summary"></div><div class="form-grid">
<div><label asp-for="UserName"></label><input asp-for="UserName" /><span asp-validation-for="UserName" class="validation"></span></div><div><label asp-for="FullName"></label><input asp-for="FullName" /><span asp-validation-for="FullName" class="validation"></span></div><div><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email" class="validation"></span></div><div><label asp-for="Role"></label><select asp-for="Role"><option value="CanBoQuanLy">Cán bộ quản lý</option><option value="Admin">Quản trị viên</option></select></div><div class="full"><label asp-for="InitialPassword"></label><input asp-for="InitialPassword" autocomplete="new-password" /><span asp-validation-for="InitialPassword" class="validation"></span></div>
</div><div class="form-actions"><a class="button secondary" asp-action="Index">Hủy</a><button class="button primary-link" type="submit">Tạo tài khoản</button></div></form></section>

@model ProvisionAccountViewModel
@{ ViewData["Title"] = "Cấp tài khoản"; }
<section class="form-card narrow"><div class="form-heading"><p class="eyebrow blue">CẤP TÀI KHOẢN</p><h1>@Model.ProfileCode</h1><p>@Model.FullName — tài khoản sẽ đăng nhập bằng mã hồ sơ này.</p></div><form method="post"><input asp-for="ProfileCode" type="hidden" /><input asp-for="FullName" type="hidden" /><input asp-for="IsLecturer" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation summary"></div>@if (Model.IsLecturer) { <label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email" class="validation"></span> } else { <input asp-for="Email" type="hidden" /> }<label asp-for="InitialPassword"></label><input asp-for="InitialPassword" autocomplete="new-password" /><span asp-validation-for="InitialPassword" class="validation"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="validation"></span><p class="field-help">Người dùng bắt buộc đổi mật khẩu tạm ngay lần đăng nhập đầu tiên.</p><div class="form-actions"><a class="button secondary" asp-action="@(Model.IsLecturer ? "Lecturers" : "Students")">Hủy</a><button class="button primary-link" type="submit">Cấp tài khoản</button></div></form></section>

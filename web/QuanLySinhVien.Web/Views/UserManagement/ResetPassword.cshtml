@model ResetPasswordViewModel
@{ ViewData["Title"] = "Cấp lại mật khẩu"; }
<section class="form-card narrow"><div class="form-heading"><p class="eyebrow blue">BẢO MẬT</p><h1>Cấp lại mật khẩu tạm</h1><p>Tài khoản: <strong>@Model.UserName</strong>. Các phiên cũ sẽ bị thu hồi.</p></div><form method="post" data-confirm="Cấp mật khẩu tạm mới cho @Model.UserName? Người dùng sẽ phải đăng nhập lại và đổi mật khẩu."><input asp-for="UserId" type="hidden" /><input asp-for="UserName" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation summary"></div><label asp-for="TemporaryPassword"></label><input asp-for="TemporaryPassword" autocomplete="new-password" /><span asp-validation-for="TemporaryPassword" class="validation"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="validation"></span><div class="form-actions"><a class="button secondary" asp-action="Details" asp-route-id="@Model.UserId">Hủy</a><button class="button primary-link" type="submit">Cấp mật khẩu tạm</button></div></form></section>

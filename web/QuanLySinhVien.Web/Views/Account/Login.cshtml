@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; ViewData["Standalone"] = true; }
<div class="login-shell">
    <section class="login-intro">
        <div class="university-mark">HUIT</div>
        <p class="eyebrow">TRƯỜNG ĐẠI HỌC CÔNG THƯƠNG TP HỒ CHÍ MINH</p>
        <h1>Hệ thống quản lý sinh viên</h1>
        <p>Quản lý lớp học, lịch học và chuyên cần trên một nền tảng thống nhất.</p>
    </section>
    <section class="auth-card">
        <p class="eyebrow blue">CỔNG THÔNG TIN</p>
        <h2>Đăng nhập hệ thống</h2>
        <p class="muted">Sử dụng mã được nhà trường cấp để tiếp tục.</p>
        <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <div asp-validation-summary="ModelOnly" class="validation summary"></div>
            <label asp-for="MaDangNhap"></label>
            <input asp-for="MaDangNhap" autocomplete="username" placeholder="Mã sinh viên, mã giảng viên hoặc tài khoản quản trị" autofocus />
            <span asp-validation-for="MaDangNhap" class="validation"></span>
            <p class="field-help">Sinh viên dùng mã sinh viên; giảng viên dùng mã giảng viên; quản trị viên và cán bộ dùng mã tài khoản được cấp.</p>
            <p class="field-help">Nếu tài khoản sinh viên đã đăng ký khuôn mặt, sau mật khẩu sẽ có thêm bước quét mặt trên website.</p>
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
            <span asp-validation-for="Password" class="validation"></span>
            <label class="checkbox"><input asp-for="RememberMe" /> @Html.DisplayNameFor(x => x.RememberMe)</label>
            <button class="primary" type="submit">Đăng nhập</button>
        </form>
    </section>
</div>

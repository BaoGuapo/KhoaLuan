@model ChangePasswordViewModel
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<section class="auth-card"><h1>Đổi mật khẩu</h1><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" /><span asp-validation-for="CurrentPassword" class="validation"></span><label asp-for="NewPassword"></label><input asp-for="NewPassword" /><span asp-validation-for="NewPassword" class="validation"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword" class="validation"></span><button class="primary" type="submit">Lưu mật khẩu mới</button></form></section>

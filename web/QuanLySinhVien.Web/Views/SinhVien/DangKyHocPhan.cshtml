@model StudentAcademicWorkspace
@{ ViewData["Title"] = "Đăng ký học phần"; var selected = Model.Selected; var enrolled = Model.SemesterRegistered.ToList(); }
<header class="sv-heading"><div><p class="sv-breadcrumb">Học tập / Đăng ký học phần</p><h1>Đăng ký học phần</h1><p>Chọn môn để xem các lớp đang mở. Kiểm tra lịch học trước khi đăng ký.</p></div><a class="sv-link" asp-action="XemLichHoc" asp-route-hocKy="@Model.Semester">Xem lịch đã đăng ký →</a></header>
@if (Model.Error is not null)
{
    <section class="sv-empty sv-error" role="alert"><h2>Chưa tải được danh sách</h2><p>@Model.Error</p><a class="button" asp-action="DangKyHocPhan">Thử lại</a></section>
}
else
{
    <form method="get" class="sv-filter" role="search" aria-label="Lọc môn học">
        <label>Học kỳ<select name="hocKy">@foreach (var semester in Model.Semesters) { <option value="@semester.MaHocKy" selected="@(semester.MaHocKy == Model.Semester)">@semester.TenHocKy</option> }</select></label>
        <label class="sv-search">Tìm môn học<input name="q" value="@Model.Query" placeholder="Nhập tên hoặc mã môn" maxlength="150" type="search" /></label>
        <label class="sv-check"><input type="checkbox" name="conCho" value="true" checked="@Model.OnlyAvailable" /> Chỉ lớp còn chỗ</label>
        <button class="button primary-link" type="submit">Tìm kiếm</button>
        @if (!string.IsNullOrWhiteSpace(Model.Query) || Model.OnlyAvailable) { <a class="sv-link" asp-action="DangKyHocPhan" asp-route-hocKy="@Model.Semester">Xóa bộ lọc</a> }
    </form>
    <div class="sv-registration-summary"><span><strong>@Model.Subjects.Count</strong> môn đang hiển thị</span><span>Đã đăng ký <strong>@enrolled.Count học phần · @enrolled.Sum(x => x.Credits) tín chỉ</strong></span><a href="#registered" class="sv-link">Xem kết quả ↓</a></div>
    @if (Model.Subjects.Count == 0)
    {
        <section class="sv-empty"><h2>@(!string.IsNullOrWhiteSpace(Model.Query) || Model.OnlyAvailable ? "Không có môn phù hợp bộ lọc" : "Chưa có lớp mở đăng ký")</h2><p>Thử chọn học kỳ khác hoặc xóa bộ lọc. Nếu thiếu môn cần học, hãy liên hệ phòng đào tạo.</p></section>
    }
    else
    {
        <div class="sv-registration-grid">
            <section class="sv-subjects" aria-labelledby="subject-list-title"><div class="sv-section-heading"><h2 id="subject-list-title">Môn học</h2><span>@Model.Subjects.Count môn</span></div>
            <div class="sv-subject-list">
                @foreach (var subject in Model.Subjects)
                {
                    var info = subject.First(); var active = selected?.Key == subject.Key;
                    <a asp-action="DangKyHocPhan" asp-route-hocKy="@Model.Semester" asp-route-q="@Model.Query" asp-route-conCho="@Model.OnlyAvailable" asp-route-mon="@subject.Key" class="sv-subject @(active ? "is-selected" : null)" aria-current="@(active ? "true" : null)">
                        <span class="sv-subject-code">@subject.Key <span>@info.Credits TC</span></span><strong>@info.TenMonHoc</strong><span class="sv-subject-meta">@subject.Count() lớp đang mở @if (Model.HasSubject(subject.Key)) { <em>Đã đăng ký</em> }</span>
                    </a>
                }
            </div></section>
            <section class="sv-classes" aria-labelledby="class-list-title">
            @if (selected is not null)
            {
                <div class="sv-section-heading sv-selected-heading"><div><span class="sv-subject-code">@selected.Key · @selected.First().Credits tín chỉ</span><h2 id="class-list-title">@selected.First().TenMonHoc</h2></div><span>@selected.Count() lớp</span></div>
                <div class="sv-table-scroll" tabindex="0" role="region" aria-label="Các lớp của môn đã chọn"><table class="sv-table sv-class-table"><thead><tr><th>Lớp học phần</th><th>Lịch học / Phòng</th><th>Giảng viên</th><th>Chỗ trống</th><th><span class="sv-sr-only">Đăng ký</span></th></tr></thead><tbody>
                @foreach (var course in selected)
                {
                    var registered = enrolled.Any(x => x.MaLopHocPhan == course.MaLopHocPhan);
                    var anotherClass = Model.HasSubject(course.MaMonHoc) && !registered;
                    var conflict = Model.Conflicts(course);
                    var unavailable = registered || anotherClass || course.Seats == 0 || conflict;
                    <tr class="@(registered ? "sv-registered-row" : null)"><td data-label="Lớp học phần"><strong class="sv-class-code">@course.MaLopHocPhan</strong>@if (registered) { <span class="sv-status sv-status-success">Đã đăng ký</span> }</td>
                        <td data-label="Lịch học / Phòng">@foreach (var slot in course.LichHoc) { <div class="sv-slot"><span>@slot.Day · Tiết @slot.TietBatDau–@slot.TietKetThuc</span><small>@slot.TenPhong</small></div> }@if (conflict && !registered) { <span class="sv-status sv-status-warning">Trùng lịch đã đăng ký</span> }</td>
                        <td data-label="Giảng viên">@course.HoTen</td><td data-label="Chỗ trống"><strong class="@(course.Seats == 0 ? "sv-full" : "sv-seats")">@course.Seats</strong><small>@course.SiSoHienTai/@course.SiSoToiDa sinh viên</small></td>
                        <td class="sv-register-action">
                        @if (unavailable)
                        { <span class="sv-unavailable">@(registered ? "Đã đăng ký" : anotherClass ? "Đã chọn lớp khác" : course.Seats == 0 ? "Hết chỗ" : "Trùng lịch")</span> }
                        else
                        {
                            <form asp-action="DangKy" method="post" data-confirm="Đăng ký lớp @course.MaLopHocPhan — @course.TenMonHoc?" data-registration-form>
                                <input type="hidden" name="maLop" value="@course.MaLopHocPhan" /><input type="hidden" name="hocKy" value="@Model.Semester" /><input type="hidden" name="mon" value="@selected.Key" /><input type="hidden" name="q" value="@Model.Query" /><input type="hidden" name="conCho" value="@Model.OnlyAvailable.ToString().ToLowerInvariant()" />
                                <button class="button primary-link" type="submit" aria-label="Đăng ký lớp @course.MaLopHocPhan">Đăng ký</button>
                            </form>
                        }
                        </td></tr>
                }
                </tbody></table></div>
                <p class="sv-table-note">Sĩ số có thể thay đổi khi sinh viên khác đăng ký. Mỗi môn chỉ được chọn một lớp trong học kỳ.</p>
            }
            </section>
        </div>
    }
    <section class="sv-section sv-enrolled" id="registered" aria-labelledby="registered-title"><div class="sv-section-heading"><h2 id="registered-title">Kết quả đăng ký</h2><strong>@enrolled.Count học phần · @enrolled.Sum(x => x.Credits) tín chỉ</strong></div>
    @if (enrolled.Count == 0) { <div class="sv-empty"><h3>Bạn chưa đăng ký học phần trong học kỳ này</h3><p>Chọn một môn ở trên, xem lịch của lớp và bấm Đăng ký.</p></div> }
    else
    {
        <div class="sv-table-scroll" tabindex="0" role="region" aria-label="Kết quả đăng ký học phần"><table class="sv-table"><thead><tr><th>Môn học / Lớp</th><th>Tín chỉ</th><th>Lịch học / Phòng</th><th>Giảng viên</th><th>Ngày đăng ký</th></tr></thead><tbody>
        @foreach (var course in enrolled) { <tr><td><strong>@course.TenMonHoc</strong><small>@course.MaLopHocPhan</small></td><td>@course.Credits</td><td>@foreach (var slot in course.LichHoc) { <div class="sv-slot">@slot.Day · Tiết @slot.TietBatDau–@slot.TietKetThuc<small>@slot.TenPhong</small></div> }</td><td>@course.HoTen</td><td>@(course.ThoiGianDangKy?.ToString("dd/MM/yyyy") ?? "—")</td></tr> }
        </tbody></table></div><p class="sv-table-note">Nếu cần hủy hoặc chuyển lớp, vui lòng liên hệ phòng đào tạo.</p>
    }
    </section>
    <script defer src="~/js/student-registration.js" asp-append-version="true"></script>
}

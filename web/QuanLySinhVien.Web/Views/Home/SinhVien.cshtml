@model UserDetailModel?
@{
    ViewData["Title"] = "Cổng sinh viên";
    ViewData["UseBootstrap"] = true;
    ViewData["StudentHome"] = true;

    var displayName = Model?.FullName ?? User.Identity?.Name ?? "Sinh viên";
    if (string.IsNullOrWhiteSpace(displayName)) displayName = "Sinh viên";
    var nameParts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length switch
    {
        0 => "SV",
        1 => nameParts[0][0].ToString().ToUpperInvariant(),
        _ => $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpperInvariant()
    };
    var profile = Model?.AcademicProfile;
    var studentCode = !string.IsNullOrWhiteSpace(Model?.ProfileCode) ? Model.ProfileCode
        : !string.IsNullOrWhiteSpace(Model?.UserName) ? Model.UserName
        : User.Identity?.Name ?? "Chưa có";
    string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "Chưa cập nhật" : value;
}

<div class="student-dashboard">
    <aside class="student-sidebar" aria-label="Điều hướng sinh viên">
        <div class="student-sidebar-heading">
            <span class="student-sidebar-mark" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
            <div><strong>Cổng sinh viên</strong><small>HUIT · Không gian học tập</small></div>
        </div>
        <nav aria-label="Chức năng sinh viên">
            <span class="student-nav-label">TỔNG QUAN</span>
            <a asp-controller="Home" asp-action="SinhVien" class="active" aria-current="page"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> Trang chủ</a>
            <a asp-controller="PersonalProfile" asp-action="Index"><i class="bi bi-person-vcard" aria-hidden="true"></i> Thông tin cá nhân</a>
            <span class="student-nav-label">HỌC TẬP</span>
            <a asp-controller="SinhVien" asp-action="XemLichHoc"><i class="bi bi-calendar-week" aria-hidden="true"></i> Lịch học</a>
            <a asp-controller="SinhVien" asp-action="DangKyHocPhan"><i class="bi bi-journal-plus" aria-hidden="true"></i> Đăng ký học phần</a>
            <span class="student-nav-label">TÀI KHOẢN</span>
            <a asp-controller="FaceRecognition" asp-action="Profile"><i class="bi bi-person-bounding-box" aria-hidden="true"></i> Hồ sơ khuôn mặt</a>
            <a asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-shield-lock" aria-hidden="true"></i> Đổi mật khẩu</a>
        </nav>
        <p class="student-sidebar-footnote">Thông tin hiển thị từ hồ sơ sinh viên của bạn.</p>
    </aside>

    <div class="student-main">
        <header class="student-welcome">
            <div>
                <p class="student-kicker">TRANG CHỦ SINH VIÊN</p>
                <h1>Chào @displayName</h1>
                <p>Theo dõi thông tin học tập và truy cập nhanh các chức năng của bạn.</p>
            </div>
            <span class="student-code"><i class="bi bi-person-badge" aria-hidden="true"></i> @studentCode</span>
        </header>

        @if (ViewData["ProfileUnavailable"] is true)
        {
            <div class="student-notice" role="status">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                Chưa tải được thông tin hồ sơ. Bạn vẫn có thể sử dụng các chức năng bên dưới.
                <a asp-controller="Home" asp-action="SinhVien">Thử lại</a>
            </div>
        }

        <div class="student-overview-grid">
            <section class="student-card student-profile" aria-labelledby="student-profile-title">
                <div class="student-card-heading">
                    <div>
                        <p class="student-kicker">HỒ SƠ HỌC TẬP</p>
                        <h2 id="student-profile-title">Thông tin sinh viên</h2>
                    </div>
                    <a asp-controller="PersonalProfile" asp-action="Index" class="student-text-link">Xem hồ sơ <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                </div>
                <div class="student-profile-content">
                    <div class="student-avatar" aria-hidden="true">@initials</div>
                    <div class="student-profile-details">
                        <h3>@displayName</h3>
                        <p>Mã sinh viên <strong>@studentCode</strong></p>
                        <dl class="student-facts">
                            <div><dt>Lớp học</dt><dd>@Display(profile?.LopHoc)</dd></div>
                            <div><dt>Khóa học</dt><dd>@Display(profile?.KhoaHoc)</dd></div>
                            <div><dt>Ngành học</dt><dd>@Display(profile?.Nganh)</dd></div>
                            <div><dt>Bậc đào tạo</dt><dd>@Display(profile?.BacDaoTao)</dd></div>
                        </dl>
                    </div>
                </div>
            </section>

            <div class="student-highlights" aria-label="Chức năng nổi bật">
                <a asp-controller="SinhVien" asp-action="XemLichHoc" class="student-highlight student-highlight-blue">
                    <span class="student-highlight-icon"><i class="bi bi-calendar-week" aria-hidden="true"></i></span>
                    <span><strong>Lịch học</strong><small>Xem buổi học, thời gian và phòng học.</small><em>Xem lịch học <i class="bi bi-arrow-right" aria-hidden="true"></i></em></span>
                </a>
                <a asp-controller="SinhVien" asp-action="DangKyHocPhan" class="student-highlight student-highlight-amber">
                    <span class="student-highlight-icon"><i class="bi bi-journal-check" aria-hidden="true"></i></span>
                    <span><strong>Đăng ký học phần</strong><small>Tra cứu và chọn lớp học phần.</small><em>Đến trang đăng ký <i class="bi bi-arrow-right" aria-hidden="true"></i></em></span>
                </a>
                <a asp-controller="FaceRecognition" asp-action="Profile" class="student-highlight student-highlight-mint">
                    <span class="student-highlight-icon"><i class="bi bi-person-bounding-box" aria-hidden="true"></i></span>
                    <span><strong>Hồ sơ khuôn mặt</strong><small>Đăng ký hoặc cập nhật để điểm danh.</small><em>Mở hồ sơ <i class="bi bi-arrow-right" aria-hidden="true"></i></em></span>
                </a>
            </div>
        </div>

        <section class="student-shortcuts" aria-labelledby="student-shortcuts-title">
            <div class="student-section-heading"><h2 id="student-shortcuts-title">Truy cập nhanh</h2><p>Những thao tác bạn thường dùng</p></div>
            <div class="student-shortcut-grid">
                <a asp-controller="PersonalProfile" asp-action="Index"><span><i class="bi bi-person-vcard" aria-hidden="true"></i></span>Hồ sơ cá nhân</a>
                <a asp-controller="SinhVien" asp-action="XemLichHoc"><span><i class="bi bi-calendar-week" aria-hidden="true"></i></span>Lịch học</a>
                <a asp-controller="SinhVien" asp-action="DangKyHocPhan"><span><i class="bi bi-journal-plus" aria-hidden="true"></i></span>Đăng ký học phần</a>
                <a asp-controller="FaceRecognition" asp-action="Profile"><span><i class="bi bi-person-bounding-box" aria-hidden="true"></i></span>Khuôn mặt</a>
                <a asp-controller="Account" asp-action="ChangePassword"><span><i class="bi bi-shield-lock" aria-hidden="true"></i></span>Đổi mật khẩu</a>
            </div>
        </section>

        <div class="student-bottom-grid">
            <section class="student-card student-details" aria-labelledby="student-details-title">
                <div class="student-card-heading"><div><p class="student-kicker">THÔNG TIN BỔ SUNG</p><h2 id="student-details-title">Hồ sơ đào tạo</h2></div></div>
                <dl class="student-facts">
                    <div><dt>Khoa</dt><dd>@Display(profile?.Khoa)</dd></div>
                    <div><dt>Cơ sở</dt><dd>@Display(profile?.CoSo)</dd></div>
                    <div><dt>Loại hình đào tạo</dt><dd>@Display(profile?.LoaiHinhDaoTao)</dd></div>
                    <div><dt>Chuyên ngành</dt><dd>@Display(profile?.ChuyenNganh)</dd></div>
                </dl>
                <a asp-controller="PersonalProfile" asp-action="Index" class="student-text-link">Xem toàn bộ thông tin <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </section>
            <section class="student-card student-account" aria-labelledby="student-account-title">
                <div class="student-card-heading"><div><p class="student-kicker">TÀI KHOẢN</p><h2 id="student-account-title">Bảo mật và hỗ trợ</h2></div></div>
                <p>Giữ thông tin đăng nhập an toàn và cập nhật hồ sơ cá nhân khi có thay đổi.</p>
                <div class="student-account-actions">
                    <a asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key" aria-hidden="true"></i> Đổi mật khẩu</a>
                    <a asp-controller="PersonalProfile" asp-action="Edit"><i class="bi bi-pencil-square" aria-hidden="true"></i> Cập nhật thông tin</a>
                </div>
            </section>
        </div>
    </div>
</div>

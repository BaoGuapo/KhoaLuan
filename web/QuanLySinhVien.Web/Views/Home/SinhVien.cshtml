@{ ViewData["Title"] = "Sinh viên"; }
<section class="dashboard-heading"><p class="eyebrow blue">SINH VIÊN</p><h1>Cổng thông tin sinh viên</h1><p>Chào @User.Identity?.Name. Phiên đăng nhập đã được xác thực đúng role sinh viên.</p></section>
<div class="role-grid"><article><h2>Phạm vi quyền</h2><p>Hồ sơ, đăng ký môn học, lịch học và chuyên cần thuộc các tuần triển khai tiếp theo.</p></article><article><h2>Bảo mật tài khoản</h2><a asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a></article></div>

<div class="row g-4 mb-4">
    <!-- Thẻ Đăng ký học phần -->
    <div class="col-md-6">
        <div class="card h-100" style="border: 1px solid #dbe4ec; border-radius: 8px; box-shadow: none; background-color: #fff;">
            <div class="card-body" style="padding: 1.5rem;">
                <h5 class="fw-bold" style="color: #006699; margin-bottom: 1rem; font-size: 1.15rem;">
                    Đăng ký học phần
                </h5>
                <p class="card-text" style="color: #333; margin-bottom: 1.5rem; font-size: 0.95rem; line-height: 1.5;">
                    Thực hiện đăng ký môn học mới, học lại, cải thiện và xem danh sách lớp học phần theo chương trình đào tạo.
                </p>
                <a href="/SinhVien/DangKyHocPhan" class="fw-bold" style="color: #006699; text-decoration: underline; font-size: 0.95rem;">
                    Truy cập ngay
                </a>
            </div>
        </div>
    </div>

    <!-- Thẻ Xem lịch học -->
    <div class="col-md-6">
        <div class="card h-100" style="border: 1px solid #dbe4ec; border-radius: 8px; box-shadow: none; background-color: #fff;">
            <div class="card-body" style="padding: 1.5rem;">
                <h5 class="fw-bold" style="color: #006699; margin-bottom: 1rem; font-size: 1.15rem;">
                    Xem lịch học
                </h5>
                <p class="card-text" style="color: #333; margin-bottom: 1.5rem; font-size: 0.95rem; line-height: 1.5;">
                    Tra cứu thời khóa biểu chi tiết theo tuần, ca học, phòng học và giảng viên cho các môn đã đăng ký.
                </p>
                <a href="/SinhVien/XemLichHoc" class="fw-bold" style="color: #006699; text-decoration: underline; font-size: 0.95rem;">
                    Truy cập ngay
                </a>
            </div>
        </div>
    </div>
</div>
@model LecturerClassWorkspaceModel
@{ ViewData["Title"] = "Quản lý lớp học phần"; var selected = Model.BuoiHoc.FirstOrDefault(x => x.MaBuoiHoc == Model.MaBuoiHocDangChon); }
<div class="page-heading">
    <div><p class="eyebrow blue">LỚP PHỤ TRÁCH</p><h1>@Model.LopHocPhan.TenMonHoc</h1><p>@Model.LopHocPhan.MaLopHocPhan · @Model.LopHocPhan.TenHocKy · @Model.LopHocPhan.MaPhong</p></div>
    <a class="button secondary" asp-action="LichGiangDay">Quay lại lịch dạy</a>
</div>

<section class="class-overview">
    <article><span>Lịch dạy</span><strong>@(Model.LopHocPhan.ThuTrongTuan == 8 ? "Chủ nhật" : $"Thứ {Model.LopHocPhan.ThuTrongTuan}")</strong><small>Tiết @Model.LopHocPhan.TietBatDau - @Model.LopHocPhan.TietKetThuc</small></article>
    <article><span>Phòng học</span><strong>@Model.LopHocPhan.MaPhong</strong><small>@Model.LopHocPhan.TenPhong</small></article>
    <article><span>Sĩ số</span><strong>@Model.LopHocPhan.SiSoHienTai/@Model.LopHocPhan.SiSoToiDa</strong><small>Sinh viên đã đăng ký</small></article>
    <article><span>Số buổi học</span><strong>@Model.BuoiHoc.Count</strong><small>@Model.BuoiHoc.Count(x => x.DaChot) buổi đã chốt</small></article>
</section>

<section class="panel section-gap">
    <div class="attendance-toolbar">
        <form method="get" asp-action="QuanLyLop" class="session-picker">
            <input type="hidden" name="maLop" value="@Model.LopHocPhan.MaLopHocPhan" />
            <label for="maBuoiHoc">Buổi học</label>
            <select id="maBuoiHoc" name="maBuoiHoc">
                @foreach (var session in Model.BuoiHoc) { <option value="@session.MaBuoiHoc" selected="@(session.MaBuoiHoc == Model.MaBuoiHocDangChon)">@session.NgayHocCuThe.ToString("dd/MM/yyyy") - @(session.DaChot ? "Đã chốt" : "Chưa chốt")</option> }
            </select>
            <button class="button secondary" type="submit">Xem buổi</button>
        </form>
        @if (selected is not null && !selected.DaChot)
        {
            <a class="button primary-link" asp-controller="FaceRecognition" asp-action="Attendance" asp-route-maBuoiHoc="@selected.MaBuoiHoc" asp-route-maLop="@Model.LopHocPhan.MaLopHocPhan" asp-route-ngayHoc="@selected.NgayHocCuThe.ToString("dd/MM/yyyy")">Điểm danh bằng khuôn mặt</a>
            <form method="post" asp-action="ChotDiemDanh" data-confirm="Chốt điểm danh buổi @selected.NgayHocCuThe.ToString("dd/MM/yyyy")? Sau khi chốt, bạn không thể chỉnh sửa kết quả buổi này."><input type="hidden" name="maLop" value="@Model.LopHocPhan.MaLopHocPhan" /><input type="hidden" name="maBuoiHoc" value="@selected.MaBuoiHoc" /><button class="button success-button" type="submit">Chốt điểm danh</button></form>
        }
        else if (selected?.DaChot == true) { <span class="badge badge-success">Buổi học đã chốt</span> }
    </div>

    <h2>Điểm danh buổi học</h2>
    <p class="section-help">Chọn trạng thái cho từng sinh viên rồi bấm Lưu. Chỉ chốt buổi học sau khi đã kiểm tra toàn bộ danh sách.</p>
    <div class="table-card" role="region" aria-label="Điểm danh sinh viên" tabindex="0"><table><thead><tr><th scope="col">Sinh viên</th><th scope="col">Liên hệ</th><th scope="col">Trạng thái buổi này</th><th scope="col">Thao tác</th></tr></thead><tbody>
    @foreach (var item in Model.SinhVien)
    {
        <tr>
            <td><strong>@item.MaSinhVien</strong><small>@item.HoTen</small></td>
            <td>@item.Email<small>@(item.SoDienThoai ?? "Chưa có SĐT")</small></td>
            <td><span class="badge @AttendanceBadge(item.TrangThaiBuoiHoc)">@AttendanceLabel(item.TrangThaiBuoiHoc)</span>@if (item.ThoiGianCheckIn.HasValue) { <small>@item.ThoiGianCheckIn.Value.ToLocalTime().ToString("HH:mm dd/MM")</small> }</td>
            <td>
                @if (selected is not null && !selected.DaChot)
                {
                    <form method="post" asp-action="CapNhatDiemDanh" class="inline-form attendance-form">
                        <input type="hidden" name="maLop" value="@Model.LopHocPhan.MaLopHocPhan" /><input type="hidden" name="maBuoiHoc" value="@selected.MaBuoiHoc" /><input type="hidden" name="maSinhVien" value="@item.MaSinhVien" />
                        <select name="trangThai" aria-label="Trạng thái điểm danh của @item.HoTen (@item.MaSinhVien)" required><option value="" disabled selected="@(item.TrangThaiBuoiHoc is not ("CoMat" or "DiTre" or "CoPhep" or "Vang"))">Chọn trạng thái</option><option value="CoMat" selected="@(item.TrangThaiBuoiHoc == "CoMat")">Có mặt</option><option value="DiTre" selected="@(item.TrangThaiBuoiHoc == "DiTre")">Đi trễ</option><option value="CoPhep" selected="@(item.TrangThaiBuoiHoc == "CoPhep")">Vắng có phép</option><option value="Vang" selected="@(item.TrangThaiBuoiHoc == "Vang")">Vắng</option></select><button class="button" type="submit" aria-label="Lưu điểm danh của @item.HoTen">Lưu</button>
                    </form>
                }
                else { <span class="muted">Không thể sửa</span> }
            </td>
        </tr>
    }
    @if (Model.SinhVien.Count == 0) { <tr><td colspan="4" class="empty-state">Lớp chưa có sinh viên đăng ký.</td></tr> }
    </tbody></table></div>
</section>

<section class="panel section-gap">
    <h2>Tổng hợp chuyên cần</h2>
    <div class="table-card"><table><thead><tr><th>Sinh viên</th><th>Có mặt</th><th>Đi trễ</th><th>Có phép</th><th>Vắng</th><th>Cảnh báo</th></tr></thead><tbody>
    @foreach (var item in Model.SinhVien)
    {
        <tr><td><strong>@item.MaSinhVien</strong><small>@item.HoTen</small></td><td>@item.CoMat</td><td>@item.DiTre</td><td>@item.CoPhep</td><td><strong>@item.Vang</strong>/@item.TongSoBuoi</td><td><span class="badge @(item.TrangThaiCanhBao == "CamThi" ? "badge-danger" : item.TrangThaiCanhBao == "CanhBao" ? "badge-warning" : "badge-success")">@(item.TrangThaiCanhBao == "CamThi" ? "Cấm thi" : item.TrangThaiCanhBao == "CanhBao" ? "Cảnh báo" : "Bình thường")</span></td></tr>
    }
    </tbody></table></div>
</section>

@functions {
    static string AttendanceLabel(string value) => value switch { "CoMat" => "Có mặt", "DiTre" => "Đi trễ", "CoPhep" => "Vắng có phép", "Vang" => "Vắng", _ => "Chưa điểm danh" };
    static string AttendanceBadge(string value) => value switch { "CoMat" => "badge-success", "DiTre" or "CoPhep" => "badge-warning", "Vang" => "badge-danger", _ => "" };
}

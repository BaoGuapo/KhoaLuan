@{
    ViewData["Title"] = "Lịch giảng dạy";
}

<style>
    :root {
        --huit-blue: #005b9f; 
        --huit-border: #dbe4ec;
    }
    .text-huit { color: var(--huit-blue) !important; }
    .schedule-wrapper { border-radius: 12px; overflow: hidden; border: 1px solid var(--huit-border); background: #fff; }
    .schedule-table th { background-color: #f8f9fa; color: var(--huit-blue); font-weight: 600; text-align: center; border-bottom: 2px solid var(--huit-blue); padding: 15px; }
    .schedule-table td { border-color: #f0f4f8; min-width: 140px; height: 110px; padding: 10px; vertical-align: top; }
    .shift-col { width: 90px; min-width: 90px !important; vertical-align: middle !important; background-color: #fafbfc; font-weight: 600; color: #555; text-align: center; border-right: 1px solid var(--huit-border); }
    .grid-bg {
        background-size: 20px 20px;
        background-image: linear-gradient(to right, #f8f9fa 1px, transparent 1px), linear-gradient(to bottom, #f8f9fa 1px, transparent 1px);
    }
    
    /* Đã bỏ viền vàng, làm full xanh theo yêu cầu */
    .schedule-card {
        background: var(--huit-blue); 
        color: white;
        border-radius: 8px; 
        font-size: 0.85rem; 
        cursor: pointer; 
        transition: all 0.25s ease;
        box-shadow: 0 4px 6px rgba(0, 91, 159, 0.15);
    }
    .schedule-card:hover { transform: translateY(-4px); box-shadow: 0 8px 15px rgba(0, 91, 159, 0.3); }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-huit mb-0"><i class="bi bi-calendar-week me-2"></i>Lịch giảng dạy tuần</h3>
        <span class="badge bg-white text-dark border px-3 py-2 fs-6 shadow-sm"><i class="bi bi-clock-history me-2 text-huit"></i>Tuần hiện tại</span>
    </div>

    <div class="schedule-wrapper shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-bordered schedule-table mb-0 grid-bg">
                <thead>
                    <tr>
                        <th class="shift-col">Ca dạy</th>
                        <th>Thứ 2</th>
                        <th>Thứ 3</th>
                        <th>Thứ 4</th>
                        <th>Thứ 5</th>
                        <th>Thứ 6</th>
                        <th>Thứ 7</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="shift-col">Sáng</td>
                        <td>
                            <!-- Click sẽ chuyển hướng sang trang QuanLyLop -->
                            <div class="schedule-card text-start p-3" onclick="window.location.href='/GiangVien/QuanLyLop?maLop=IT01_HK1_01'">
                                <div class="fw-bold mb-2" style="font-size: 1rem; line-height: 1.3;">Lập trình Web ASP.NET</div>
                                <div class="mb-1">IT01_HK1_01</div>
                                <div class="mb-1">Tiết: 1 - 3 &nbsp;|&nbsp; P. C101</div>
                                <div class="mt-2 pt-2 border-top border-light border-opacity-25 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold"><i class="bi bi-people-fill"></i> Sĩ số: 45/70</span>
                                </div>
                            </div>
                        </td>
                        <td></td><td></td><td></td><td></td><td></td>
                    </tr>
                    <tr>
                        <td class="shift-col">Chiều</td>
                        <td></td><td></td><td></td><td></td><td></td><td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
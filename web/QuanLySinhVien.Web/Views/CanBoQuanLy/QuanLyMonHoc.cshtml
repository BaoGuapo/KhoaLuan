@{
    ViewData["Title"] = "Quản lý Danh mục Môn học";
}

<!-- NHÚNG ĐẦY ĐỦ BOOTSTRAP 5 CSS, ICONS & SHEETJS MỚI NHẤT -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<style>
    :root {
        --primary-color: #005b9f;
        --bg-light: #f4f6f9;
        --border-color: #e0e5ec;
        --text-main: #333333;
        --font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
        font-family: var(--font-family);
        background-color: var(--bg-light);
        color: var(--text-main);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .page-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 0.25rem;
    }

    .page-subtitle {
        font-size: 0.95rem;
        color: #6c757d;
        margin-bottom: 0;
    }

    .btn-header-group {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-pill-primary {
        background-color: var(--primary-color);
        color: white;
        border: 1px solid var(--primary-color);
        padding: 8px 22px;
        font-weight: 600;
        border-radius: 30px;
        font-size: 0.92rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 4px rgba(0, 91, 159, 0.2);
        cursor: pointer;
    }
    .btn-pill-primary:hover {
        background-color: #00467a;
        color: white;
    }

    .btn-pill-outline {
        background-color: transparent;
        color: var(--primary-color);
        border: 1.5px solid var(--primary-color);
        padding: 8px 20px;
        font-weight: 600;
        border-radius: 30px;
        font-size: 0.92rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .btn-pill-outline:hover {
        background-color: #eaf3fa;
        color: var(--primary-color);
    }

    .btn-pill-excel {
        background-color: #198754;
        color: white;
        border: 1px solid #198754;
        padding: 8px 20px;
        font-weight: 600;
        border-radius: 30px;
        font-size: 0.92rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .btn-pill-excel:hover {
        background-color: #146c43;
        color: white;
    }

    .custom-card {
        background-color: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    }

    .filter-bar {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        background-color: #f8fafc;
        padding: 1rem 1.25rem;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
    }

    .filter-item {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filter-item label {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--primary-color);
        white-space: nowrap;
        margin-bottom: 0;
    }

    .filter-item .form-select {
        height: 38px;
        border-radius: 6px;
        font-size: 0.9rem;
        min-width: 180px;
        border: 1px solid #ced4da;
    }

    .table-custom {
        margin-bottom: 0;
    }

    .table-custom th {
        background-color: #eaf3fa;
        color: var(--primary-color);
        font-weight: 600;
        border-bottom: 2px solid #cce0f0;
        padding: 12px 10px;
        font-size: 0.85rem;
        text-transform: uppercase;
    }

    .table-custom td {
        vertical-align: middle;
        padding: 12px 10px;
        font-size: 0.9rem;
    }

    .btn-action-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid;
        background-color: transparent;
        transition: all 0.2s ease;
        padding: 0;
        font-size: 0.88rem;
    }

    .btn-action-edit {
        color: #0d6efd;
        border-color: #0d6efd;
    }
    .btn-action-edit:hover {
        background-color: #0d6efd;
        color: #ffffff;
    }

    .btn-action-delete {
        color: #dc3545;
        border-color: #dc3545;
    }
    .btn-action-delete:hover {
        background-color: #dc3545;
        color: #ffffff;
    }

    .badge-bat-buoc {
        background-color: #146c43;
        color: #ffffff;
        font-weight: 500;
        padding: 5px 14px;
        border-radius: 12px;
        font-size: 0.82rem;
    }

    .badge-tu-chon {
        background-color: #ffc107;
        color: #000000;
        font-weight: 600;
        padding: 5px 14px;
        border-radius: 12px;
        font-size: 0.82rem;
    }

    .pagination .page-item.active .page-link {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
    }
    .pagination .page-link {
        color: var(--primary-color);
        border-radius: 6px;
        margin: 0 2px;
    }
</style>

<div class="container-fluid py-4" style="max-width: 1400px;">
    <!-- TIÊU ĐỀ TRANG VÀ NHÓM NÚT TÁC VỤ -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Quản lý Danh mục Môn học</h1>
            <p class="page-subtitle">Cấu hình danh mục môn học và số tín chỉ đào tạo.</p>
        </div>

        <div class="btn-header-group">
            <input type="file" id="fileExcelInput" accept=".xlsx, .xls" style="display: none;" onchange="xuLyImportExcel(event)" />
            <button class="btn-pill-excel" onclick="document.getElementById('fileExcelInput').click()">
                <i class="bi bi-file-earmark-excel"></i> Nhập từ Excel
            </button>

            <button class="btn-pill-outline" onclick="moModalNganh()">
                <i class="bi bi-folder-plus"></i> Tạo ngành mới
            </button>

            <button class="btn-pill-primary" onclick="moModalThemMon()">
                <i class="bi bi-plus-circle"></i> Thêm môn học mới
            </button>
        </div>
    </div>

    <div class="custom-card">
        <!-- THANH 2 COMBOBOX LỌC DANH SÁCH -->
        <div class="filter-bar">
            <div class="filter-item">
                <label><i class="bi bi-funnel me-1"></i> Ngành đào tạo:</label>
                <select class="form-select" id="cboFilterNganh" onchange="currentPage = 1; locDanhSachMonHoc();">
                    <option value="">Tất cả ngành</option>
                </select>
            </div>

            <div class="filter-item">
                <label><i class="bi bi-tags me-1"></i> Phân loại môn:</label>
                <select class="form-select" id="cboFilterPhanLoai" onchange="currentPage = 1; locDanhSachMonHoc();">
                    <option value="">Tất cả phân loại</option>
                    <option value="batbuoc">Bắt buộc</option>
                    <option value="tuchon">Tự chọn</option>
                </select>
            </div>

            <div class="ms-auto text-muted" style="font-size: 0.88rem;">
                Hiển thị: <strong id="lblSoLuongMon" class="text-primary">0</strong> môn học
            </div>
        </div>

        <!-- BẢNG DANH SÁCH MÔN HỌC -->
        <div class="table-responsive">
            <table class="table table-hover table-custom align-middle text-center">
                <thead>
                    <tr>
                        <th width="5%">STT</th>
                        <th width="12%">MÃ MÔN</th>
                        <th width="33%" class="text-start">TÊN MÔN HỌC</th>
                        <th width="12%">NGÀNH</th>
                        <th width="8%">SỐ TC</th>
                        <th width="8%">TIẾT LT</th>
                        <th width="8%">TIẾT TH</th>
                        <th width="10%">PHÂN LOẠI</th>
                        <th width="10%">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="tbodyDsMonHoc">
                    <tr><td colspan="9" class="text-muted p-4">Đang nạp danh sách môn học từ CSDL...</td></tr>
                </tbody>
            </table>
        </div>

        <!-- THANH PHÂN TRANG -->
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
            <div class="text-muted" style="font-size: 0.88rem;" id="lblPageInfo">
                Hiển thị 0 đến 0 trong 0 môn học
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0" id="ulPagination">
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL THÊM / SỬA MÔN HỌC -->
<!-- ========================================== -->
<div class="modal fade" id="modalMonHoc" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-primary" id="modalMonHocTitle">Thêm môn học mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formMonHoc">
                    <input type="hidden" id="isEditMode" value="false">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã môn học <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtMaMonHoc" required placeholder="VD: CNTT_IT1">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên môn học <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtTenMonHoc" required placeholder="VD: Lập trình web">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ngành đào tạo</label>
                        <select class="form-select" id="cboModalNganh"></select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label fw-semibold">Số TC</label>
                            <input type="number" class="form-control" id="txtSoTinChi" value="3" min="0">
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-semibold">Tiết LT</label>
                            <input type="number" class="form-control" id="txtSoTietLT" value="15" min="0">
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-semibold">Tiết TH</label>
                            <input type="number" class="form-control" id="txtSoTietTH" value="30" min="0">
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold d-block">Phân loại môn</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="radPhanLoai" id="radBatBuoc" value="false" checked>
                            <label class="form-check-label" for="radBatBuoc">Bắt buộc</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="radPhanLoai" id="radTuChon" value="true">
                            <label class="form-check-label" for="radTuChon">Tự chọn</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn-pill-primary" onclick="luuMonHoc()">Lưu dữ liệu</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL TẠO NGÀNH MỚI -->
<!-- ========================================== -->
<div class="modal fade" id="modalNganhDaoTao" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px;">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-primary">Tạo ngành mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mã ngành <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="txtMaNganhMoi" placeholder="VD: CNTT, MKT">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên ngành <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="txtTenNganhMoi" placeholder="VD: Công nghệ thông tin">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn-pill-primary" onclick="luuNganhMoi()">Lưu Ngành</button>
            </div>
        </div>
    </div>
</div>

<script>
    const API_BASE_URL = "https://localhost:7081/api"; 
    let dsMonHocGoc = [];
    let dsNganhGlobal = [];

    let currentPage = 1;
    const pageSize = 10;

    let modalMonHocObj = null;
    let modalNganhObj = null;

    document.addEventListener("DOMContentLoaded", function () {
        initModals();
        loadNganhDaoTaoFilter();
        loadDanhSachMonHoc();
    });

    function initModals() {
        if (typeof bootstrap !== 'undefined') {
            const elMon = document.getElementById('modalMonHoc');
            const elNganh = document.getElementById('modalNganhDaoTao');
            if (elMon) modalMonHocObj = new bootstrap.Modal(elMon);
            if (elNganh) modalNganhObj = new bootstrap.Modal(elNganh);
        }
    }

    // 1. Tải danh sách Ngành đào tạo
    async function loadNganhDaoTaoFilter() {
        try {
            const rootApi = typeof API_BASE !== 'undefined' ? API_BASE : API_BASE_URL;
            let res = await fetch(`${rootApi}/NganhDaoTao`);
            if (res.ok) {
                dsNganhGlobal = await res.json();
                
                let optionsFilter = '<option value="">Tất cả ngành</option>';
                let optionsModal = '<option value="">-- Chọn ngành đào tạo --</option>';

                dsNganhGlobal.forEach(n => {
                    optionsFilter += `<option value="${n.maNganh}">${n.tenNganh}</option>`;
                    optionsModal += `<option value="${n.maNganh}">${n.tenNganh}</option>`;
                });

                document.getElementById('cboFilterNganh').innerHTML = optionsFilter;
                document.getElementById('cboModalNganh').innerHTML = optionsModal;
            }
        } catch (e) {
            console.error("Lỗi tải ngành:", e);
        }
    }

    // 2. Load danh sách Môn học từ CSDL
    async function loadDanhSachMonHoc() {
        const tbody = document.getElementById('tbodyDsMonHoc');
        try {
            const rootApi = typeof API_BASE !== 'undefined' ? API_BASE : API_BASE_URL;
            let res = await fetch(`${rootApi}/MonHoc`);
            if (!res.ok) throw new Error(await res.text());

            dsMonHocGoc = await res.json();
            locDanhSachMonHoc();

        } catch (e) {
            tbody.innerHTML = `<tr><td colspan="9" class="text-danger p-4">Lỗi kết nối CSDL: ${e.message}</td></tr>`;
        }
    }

    // 3. Hàm Lọc dữ liệu & Phân trang
    function locDanhSachMonHoc() {
        const maNganhVal = document.getElementById('cboFilterNganh').value;
        const phanLoaiVal = document.getElementById('cboFilterPhanLoai').value;
        const tbody = document.getElementById('tbodyDsMonHoc');

        let dataFiltered = dsMonHocGoc.filter(item => {
            let maNganhItem = item.maNganh || item.MaNganh || '';
            let laTuChonItem = item.laMonTuChon ?? item.LaMonTuChon ?? false;

            let matchNganh = (maNganhVal === "") || (maNganhItem === maNganhVal);
            let matchPhanLoai = true;
            if (phanLoaiVal === "batbuoc") matchPhanLoai = (laTuChonItem === false);
            if (phanLoaiVal === "tuchon") matchPhanLoai = (laTuChonItem === true);

            return matchNganh && matchPhanLoai;
        });

        const totalItems = dataFiltered.length;
        document.getElementById('lblSoLuongMon').innerText = totalItems;

        if (totalItems === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-muted p-4">Không tìm thấy môn học phù hợp với điều kiện lọc.</td></tr>';
            renderPaginationControls(0);
            return;
        }

        const totalPages = Math.ceil(totalItems / pageSize);
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIndex = (currentPage - 1) * pageSize;
        const endIndex = Math.min(startIndex + pageSize, totalItems);
        const pageItems = dataFiltered.slice(startIndex, endIndex);

        let html = '';
        pageItems.forEach((m, idx) => {
            let stt = startIndex + idx + 1;
            let maMon = m.maMonHoc || m.MaMonHoc;
            let tenMon = m.tenMonHoc || m.TenMonHoc;
            let maNganh = m.maNganh || m.MaNganh || '';
            let soTc = m.soTinChi ?? m.SoTinChi ?? 0;
            let tietLt = m.soTietLyThuyet ?? m.SoTietLyThuyet ?? 0;
            let tietTh = m.soTietThucHanh ?? m.SoTietThucHanh ?? 0;
            let laTuChon = m.laMonTuChon ?? m.LaMonTuChon ?? false;

            html += `
                <tr>
                    <td class="text-muted">${stt}</td>
                    <td class="fw-bold text-dark">${maMon}</td>
                    <td class="text-start fw-medium">${tenMon}</td>
                    <td>${maNganh}</td>
                    <td class="fw-bold text-primary">${soTc}</td>
                    <td>${tietLt}</td>
                    <td>${tietTh}</td>
                    <td>
                        <span class="${laTuChon ? 'badge-tu-chon' : 'badge-bat-buoc'}">
                            ${laTuChon ? 'Tự chọn' : 'Bắt buộc'}
                        </span>
                    </td>
                    <td>
                        <button class="btn-action-icon btn-action-edit me-1" onclick="moSuaMon('${maMon}')" title="Sửa">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn-action-icon btn-action-delete" onclick="xoaMon('${maMon}')" title="Xóa">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>`;
        });

        tbody.innerHTML = html;
        renderPaginationControls(totalItems, startIndex + 1, endIndex);
    }

    function renderPaginationControls(totalItems, fromIdx = 0, toIdx = 0) {
        const lblInfo = document.getElementById('lblPageInfo');
        const ulPag = document.getElementById('ulPagination');

        if (totalItems === 0) {
            lblInfo.innerText = "Hiển thị 0 đến 0 trong 0 môn học";
            ulPag.innerHTML = '';
            return;
        }

        lblInfo.innerText = `Hiển thị ${fromIdx} đến ${toIdx} trong ${totalItems} môn học`;
        const totalPages = Math.ceil(totalItems / pageSize);

        let pagHtml = '';
        pagHtml += `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
            <a class="page-link" href="javascript:void(0)" onclick="chuyenTrang(${currentPage - 1})">Trở lại</a>
        </li>`;

        for (let p = 1; p <= totalPages; p++) {
            pagHtml += `<li class="page-item ${p === currentPage ? 'active' : ''}">
                <a class="page-link" href="javascript:void(0)" onclick="chuyenTrang(${p})">${p}</a>
            </li>`;
        }

        pagHtml += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
            <a class="page-link" href="javascript:void(0)" onclick="chuyenTrang(${currentPage + 1})">Tiếp theo</a>
        </li>`;

        ulPag.innerHTML = pagHtml;
    }

    function chuyenTrang(page) {
        currentPage = page;
        locDanhSachMonHoc();
    }

    // 4. MỞ MODAL THÊM MÔN HỌC
    function moModalThemMon() {
        document.getElementById('isEditMode').value = "false";
        document.getElementById('modalMonHocTitle').innerText = "Thêm môn học mới";
        document.getElementById('txtMaMonHoc').disabled = false;

        document.getElementById('formMonHoc').reset();
        document.getElementById('radBatBuoc').checked = true;

        if (!modalMonHocObj && typeof bootstrap !== 'undefined') {
            modalMonHocObj = new bootstrap.Modal(document.getElementById('modalMonHoc'));
        }
        if (modalMonHocObj) modalMonHocObj.show();
    }

    // 5. MỞ MODAL SỬA MÔN HỌC
    function moSuaMon(maMon) {
        const mon = dsMonHocGoc.find(x => (x.maMonHoc || x.MaMonHoc) === maMon);
        if (!mon) return alert("Không tìm thấy dữ liệu môn học!");

        document.getElementById('isEditMode').value = "true";
        document.getElementById('modalMonHocTitle').innerText = "Cập nhật thông tin môn học";
        
        const txtMa = document.getElementById('txtMaMonHoc');
        txtMa.value = mon.maMonHoc || mon.MaMonHoc;
        txtMa.disabled = true;

        document.getElementById('txtTenMonHoc').value = mon.tenMonHoc || mon.TenMonHoc || "";
        document.getElementById('cboModalNganh').value = mon.maNganh || mon.MaNganh || "";
        document.getElementById('txtSoTinChi').value = mon.soTinChi ?? mon.SoTinChi ?? 3;
        document.getElementById('txtSoTietLT').value = mon.soTietLyThuyet ?? mon.SoTietLyThuyet ?? 15;
        document.getElementById('txtSoTietTH').value = mon.soTietThucHanh ?? mon.SoTietThucHanh ?? 30;

        let laTuChon = mon.laMonTuChon ?? mon.LaMonTuChon ?? false;
        if (laTuChon) {
            document.getElementById('radTuChon').checked = true;
        } else {
            document.getElementById('radBatBuoc').checked = true;
        }

        if (!modalMonHocObj && typeof bootstrap !== 'undefined') {
            modalMonHocObj = new bootstrap.Modal(document.getElementById('modalMonHoc'));
        }
        if (modalMonHocObj) modalMonHocObj.show();
    }

    // 6. LƯU MÔN HỌC
    async function luuMonHoc() {
        const isEdit = document.getElementById('isEditMode').value === "true";
        const maMon = document.getElementById('txtMaMonHoc').value.trim();
        const tenMon = document.getElementById('txtTenMonHoc').value.trim();
        const maNganh = document.getElementById('cboModalNganh').value;
        const soTc = parseInt(document.getElementById('txtSoTinChi').value) || 0;
        const tietLt = parseInt(document.getElementById('txtSoTietLT').value) || 0;
        const tietTh = parseInt(document.getElementById('txtSoTietTH').value) || 0;
        const laTuChon = document.getElementById('radTuChon').checked;

        if (!maMon || !tenMon) {
            return alert("Vui lòng điền đầy đủ Mã môn học và Tên môn học!");
        }

        const payload = {
            MaMonHoc: maMon,
            TenMonHoc: tenMon,
            MaNganh: maNganh,
            SoTinChi: soTc,
            SoTietLyThuyet: tietLt,
            SoTietThucHanh: tietTh,
            LaMonTuChon: laTuChon
        };

        const rootApi = typeof API_BASE !== 'undefined' ? API_BASE : API_BASE_URL;
        const url = isEdit ? `${rootApi}/MonHoc/${maMon}` : `${rootApi}/MonHoc`;
        const method = isEdit ? 'PUT' : 'POST';

        try {
            let res = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                let errText = await res.text();
                let jsonErr = {};
                try { jsonErr = JSON.parse(errText); } catch(ex){}
                throw new Error(jsonErr.message || errText);
            }

            alert(isEdit ? "Cập nhật môn học thành công!" : "Thêm môn học mới thành công!");
            if (modalMonHocObj) modalMonHocObj.hide();
            await loadDanhSachMonHoc();

        } catch (e) {
            alert("Lỗi khi lưu môn học: " + e.message);
        }
    }

    // 7. XÓA MÔN HỌC
    async function xoaMon(maMon) {
        if (!confirm(`Bạn có chắc chắn muốn xóa môn học [${maMon}] không?`)) return;

        try {
            const rootApi = typeof API_BASE !== 'undefined' ? API_BASE : API_BASE_URL;
            let res = await fetch(`${rootApi}/MonHoc/${maMon}`, { method: 'DELETE' });
            if (res.ok) {
                alert("Đã xóa môn học thành công!");
                await loadDanhSachMonHoc();
            } else {
                alert("Lỗi khi xóa: " + await res.text());
            }
        } catch (e) {
            alert("Lỗi kết nối API xóa: " + e.message);
        }
    }

    // 8. TẠO NGÀNH MỚI
    function moModalNganh() {
        document.getElementById('txtMaNganhMoi').value = "";
        document.getElementById('txtTenNganhMoi').value = "";
        if (!modalNganhObj && typeof bootstrap !== 'undefined') {
            modalNganhObj = new bootstrap.Modal(document.getElementById('modalNganhDaoTao'));
        }
        if (modalNganhObj) modalNganhObj.show();
    }

    async function luuNganhMoi() {
        const maNganh = document.getElementById('txtMaNganhMoi').value.trim();
        const tenNganh = document.getElementById('txtTenNganhMoi').value.trim();

        if (!maNganh || !tenNganh) {
            return alert("Vui lòng điền đầy đủ Mã ngành và Tên ngành!");
        }

        try {
            const rootApi = typeof API_BASE !== 'undefined' ? API_BASE : API_BASE_URL;
            let res = await fetch(`${rootApi}/NganhDaoTao`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ MaNganh: maNganh, TenNganh: tenNganh })
            });

            if (!res.ok) {
                let errText = await res.text();
                let jsonErr = {};
                try { jsonErr = JSON.parse(errText); } catch(ex){}
                throw new Error(jsonErr.message || errText);
            }

            alert("Thêm ngành đào tạo thành công!");
            if (modalNganhObj) modalNganhObj.hide();
            await loadNganhDaoTaoFilter();

        } catch (e) {
            alert("Lỗi khi tạo ngành: " + e.message);
        }
    }

    // 9. NHẬP EXCEL
    async function xuLyImportExcel(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = async function (e) {
            try {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: 'array' });
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                const jsonData = XLSX.utils.sheet_to_json(worksheet, { defval: "" });

                if (jsonData.length === 0) {
                    alert("File Excel rỗng!");
                    return;
                }

                let countSuccess = 0;
                let countFail = 0;
                const rootApi = typeof API_BASE !== 'undefined' ? API_BASE : API_BASE_URL;

                for (let row of jsonData) {
                    let maMon = row["Mã môn"] || row["Mã môn học"] || row["MaMon"] || row["MaMonHoc"];
                    let tenMon = row["Tên môn học"] || row["Tên môn"] || row["TenMonHoc"];
                    let maNganh = row["Ngành"] || row["Mã ngành"] || row["MaNganh"];
                    let soTc = parseInt(row["Số TC"] || row["Số tín chỉ"] || row["SoTinChi"]) || 0;
                    let tietLt = parseInt(row["Tiết LT"] || row["Số tiết LT"] || row["SoTietLyThuyet"]) || 0;
                    let tietTh = parseInt(row["Tiết TH"] || row["Số tiết TH"] || row["SoTietThucHanh"]) || 0;
                    let phanLoaiStr = (row["Phân loại"] || row["PhanLoai"] || "").toString().toLowerCase();
                    
                    let laTuChon = phanLoaiStr.includes("tự chọn") || phanLoaiStr.includes("tu chon");

                    if (!maMon || !tenMon) continue;

                    try {
                        let res = await fetch(`${rootApi}/MonHoc`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                MaMonHoc: maMon.toString().trim(),
                                TenMonHoc: tenMon.toString().trim(),
                                MaNganh: maNganh ? maNganh.toString().trim() : "",
                                SoTinChi: soTc,
                                SoTietLyThuyet: tietLt,
                                SoTietThucHanh: tietTh,
                                LaMonTuChon: laTuChon
                            })
                        });

                        if (res.ok) countSuccess++;
                        else countFail++;
                    } catch (err) {
                        countFail++;
                    }
                }

                alert(`Kết quả nhập Excel:\n- Thành công: ${countSuccess} môn học.\n- Trùng mã/Lỗi: ${countFail} môn.`);
                event.target.value = "";
                await loadDanhSachMonHoc();

            } catch (err) {
                alert("Lỗi khi đọc file Excel: " + err.message);
            }
        };

        reader.readAsArrayBuffer(file);
    }
</script>